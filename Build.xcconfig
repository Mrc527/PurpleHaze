// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 5

PRODUCT_BUNDLE_PREFIX = ch.visin.iodine
OPENSSL_IOS_ROOT = $(SRCROOT)/build-ios/deps/$(PLATFORM_NAME)
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/vendor/iodine/src" "$(SRCROOT)/Extension" "$(OPENSSL_IOS_ROOT)/include"
LIBRARY_SEARCH_PATHS = $(inherited) "$(OPENSSL_IOS_ROOT)/lib"
OTHER_LDFLAGS = $(inherited) -lssl -lcrypto -lz
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Codesigning settings defined optionally
#include? "CodeSigning.xcconfig"
